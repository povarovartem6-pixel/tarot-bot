# ============== ГЕНЕРАТОР ПРОГНОЗОВ ==============
class PredictionGenerator:
    @staticmethod
    def tarot_day():
        card, meaning = random.choice(TAROT_CARDS)
        return f"<b>{card}</b>\n\n{meaning}"

    @staticmethod
    def yes_no():
        return random.choice(YES_NO_ANSWERS)

    @staticmethod
    def daily_advice():
        return random.choice(DAILY_ADVICES)

    @staticmethod
    def relationship():
        emoji, meaning = random.choice(RELATIONSHIP_READINGS)
        return f"{emoji} <b>Тройной расклад:</b>\n\n{meaning}"

    @staticmethod
    def weekly():
        days = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
        lines = ["📅 <b>Прогноз на неделю:</b>\n"]
        for day in days:
            lines.append(f"<b>{day}:</b> {random.choice(WEEKLY_FORECASTS[day])}")
        return "\n".join(lines)

    @staticmethod
    def yearly():
        return "🔮 <b>Прогноз на год:</b>\n\n" + random.choice(YEARLY_FORECASTS)

    @staticmethod
    def dream_interpretation(dream_text: str):
        text_lower = dream_text.lower()
        found = []
        for symbol, meaning in DREAM_SYMBOLS.items():
            if symbol in text_lower:
                found.append(meaning)
                if len(found) >= 3:
                    break

        if found:
            return "🌙 <b>Расшифровка сна:</b>\n\n" + "\n\n".join(found)
        return "🌙 <b>Расшифровка сна:</b>\n\n" + random.choice(UNIVERSAL_DREAM_READINGS)

