@router.message(Command("broadcast"))
async def broadcast(message: Message):
    if not db.is_owner(message.from_user.id):
        return

    text = message.text.replace("/broadcast", "").strip()
    if not text:
        await message.answer("❌ Использование: <code>/broadcast Текст</code>")
        return

    users = db.get_all_users(10000)
    sent = 0
    failed = 0

    status_msg = await message.answer(f"📢 Отправка... 0/{len(users)}")

    for u in users:
        if u["user_id"] == OWNER_ID:
            continue
        try:
            await bot.send_message(u["user_id"], f"📢 <b>Сообщение от бота:</b>\n\n{text}")
            sent += 1
        except Exception:
            failed += 1

        if sent % 10 == 0:
            try:
                await status_msg.edit_text(f"📢 Отправка... {sent + failed}/{len(users)}")
            except Exception:
                pass

        await asyncio.sleep(0.05)

    await status_msg.edit_text(
        f"✅ <b>Рассылка завершена!</b>\n\n"
        f"📤 Отправлено: <b>{sent}</b>\n"
        f"❌ Ошибок: <b>{failed}</b>"
    )

