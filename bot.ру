# ============== БАЗА ДАННЫХ ==============
class Database:
    def __init__(self, db_path: str = "bot.db"):
        self.db_path = db_path
        self.timezone = pytz.timezone(TIMEZONE)
        self.init_db()

    def get_connection(self):
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        return conn

    def init_db(self):
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS users (
                    user_id INTEGER PRIMARY KEY,
                    username TEXT,
                    full_name TEXT,
                    balance INTEGER DEFAULT 0,
                    free_today INTEGER DEFAULT 0,
                    last_free_date TEXT,
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
                    last_visit_date TEXT,
                    consecutive_days INTEGER DEFAULT 0,
                    total_predictions INTEGER DEFAULT 0,
                    total_spent INTEGER DEFAULT 0,
                    is_owner INTEGER DEFAULT 0
                )
            ''')
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER,
                    type TEXT,
                    stars_spent INTEGER,
                    date TEXT,
                    result_preview TEXT
                )
            ''')
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS payments (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER,
                    amount INTEGER,
                    date TEXT,
                    status TEXT,
                    payment_id TEXT
                )
            ''')
            conn.commit()

    def get_user(self, user_id: int) -> Optional[Dict[str, Any]]:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
            row = cursor.fetchone()
            return dict(row) if row else None

    def create_user(self, user_id: int, username: str = None, full_name: str = None) -> Dict[str, Any]:
        now = datetime.now(self.timezone)
        today = now.strftime("%Y-%m-%d")
        is_owner = 1 if user_id == OWNER_ID else 0
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                INSERT OR IGNORE INTO users 
                (user_id, username, full_name, balance, free_today, last_free_date, last_visit_date, is_owner)
                VALUES (?, ?, ?, 0, ?, ?, ?, ?)
            ''', (user_id, username, full_name, FREE_PREDICTIONS_DAILY, today, today, is_owner))
            conn.commit()
        return self.get_user(user_id)

    def is_owner(self, user_id: int) -> bool:
        return user_id == OWNER_ID

    def update_user_visit(self, user_id: int) -> None:
        user = self.get_user(user_id)
        if not user:
            return
        now = datetime.now(self.timezone)
        today = now.strftime("%Y-%m-%d")
        consecutive_days = user.get("consecutive_days", 0) or 0
        last_visit = user.get("last_visit_date")

        if last_visit:
            last_date = datetime.strptime(last_visit, "%Y-%m-%d").date()
            delta = (now.date() - last_date).days
            if delta == 1:
                consecutive_days += 1
            elif delta > 1:
                consecutive_days = 1
            elif delta == 0:
                consecutive_days = max(consecutive_days, 1)
        else:
            consecutive_days = 1

        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                UPDATE users SET last_visit_date = ?, consecutive_days = ?
                WHERE user_id = ?
            ''', (today, consecutive_days, user_id))
            conn.commit()

        if consecutive_days == DAILY_BONUS_DAYS and not self.is_owner(user_id):
            self.add_daily_bonus(user_id)

    def add_daily_bonus(self, user_id: int) -> None:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                'UPDATE users SET balance = balance + ? WHERE user_id = ?',
                (DAILY_BONUS_AMOUNT, user_id)
            )
            cursor.execute('''
                INSERT INTO history (user_id, type, stars_spent, date, result_preview)
                VALUES (?, 'daily_bonus', ?, datetime('now', 'localtime'), ?)
            ''', (user_id, DAILY_BONUS_AMOUNT, f"Ежедневный бонус за {DAILY_BONUS_DAYS} дней"))
            conn.commit()

    def check_daily_reset(self, user_id: int) -> None:
        if self.is_owner(user_id):
            return
        user = self.get_user(user_id)
        if not user:
            return
        now = datetime.now(self.timezone)
        today = now.strftime("%Y-%m-%d")
        if user.get("last_free_date") != today:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute('''
                    UPDATE users SET free_today = ?, last_free_date = ?
                    WHERE user_id = ?
                ''', (FREE_PREDICTIONS_DAILY, today, user_id))
                conn.commit()

    def use_free_prediction(self, user_id: int) -> bool:
        if self.is_owner(user_id):
            return True
        self.check_daily_reset(user_id)
        user = self.get_user(user_id)
        if user["free_today"] > 0:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute(
                    'UPDATE users SET free_today = free_today - 1 WHERE user_id = ?',
                    (user_id,)
                )
                conn.commit()
            return True
        return False

    def spend_stars(self, user_id: int, amount: int) -> bool:
        if self.is_owner(user_id):
            return True
        user = self.get_user(user_id)
        if user["balance"] >= amount:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute(
                    'UPDATE users SET balance = balance - ?, total_spent = total_spent + ? WHERE user_id = ?',
                    (amount, amount, user_id)
                )
                conn.commit()
            return True
        return False

    def add_stars(self, user_id: int, amount: int) -> None:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                'UPDATE users SET balance = balance + ? WHERE user_id = ?',
                (amount, user_id)
            )
            conn.commit()

    def add_history(self, user_id: int, type_: str, stars_spent: int, preview: str) -> None:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO history (user_id, type, stars_spent, date, result_preview)
                VALUES (?, ?, ?, datetime('now', 'localtime'), ?)
            ''', (user_id, type_, stars_spent, preview))
            conn.commit()

    def increment_predictions(self, user_id: int) -> None:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                'UPDATE users SET total_predictions = total_predictions + 1 WHERE user_id = ?',
                (user_id,)
            )
            conn.commit()

    def get_history(self, user_id: int, limit: int = 10) -> List[Dict[str, Any]]:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(
                'SELECT * FROM history WHERE user_id = ? ORDER BY id DESC LIMIT ?',
                (user_id, limit)
            )
            return [dict(row) for row in cursor.fetchall()]

    def add_payment(self, user_id: int, amount: int, payment_id: str, status: str = "completed") -> None:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                INSERT INTO payments (user_id, amount, date, status, payment_id)
                VALUES (?, ?, datetime('now', 'localtime'), ?, ?)
            ''', (user_id, amount, status, payment_id))
            conn.commit()

    def get_stats(self) -> Dict[str, Any]:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT COUNT(*) as total FROM users")
            total_users = cursor.fetchone()["total"]

            cursor.execute("SELECT COUNT(*) as today FROM users WHERE DATE(created_at) = DATE('now')")
            new_today = cursor.fetchone()["today"]

            cursor.execute("SELECT COUNT(*) as week FROM users WHERE created_at >= datetime('now', '-7 days')")
            new_week = cursor.fetchone()["week"]

            cursor.execute("SELECT COALESCE(SUM(amount), 0) as s FROM payments WHERE status='completed'")
            total_stars = cursor.fetchone()["s"]

            cursor.execute("SELECT COALESCE(SUM(amount), 0) as s FROM payments WHERE status='completed' AND DATE(date) = DATE('now')")
            stars_today = cursor.fetchone()["s"]

            cursor.execute("SELECT COUNT(*) as c FROM history WHERE type NOT IN ('top_up','daily_bonus','gift_received')")
            total_predictions = cursor.fetchone()["c"]

            cursor.execute("SELECT COUNT(*) as c FROM payments WHERE status='completed'")
            payments_count = cursor.fetchone()["c"]

            return {
                "total_users": total_users,
                "new_today": new_today,
                "new_week": new_week,
                "total_stars": total_stars,
                "stars_today": stars_today,
                "total_predictions": total_predictions,
                "payments_count": payments_count,
            }

    def get_all_users(self, limit: int = 50) -> List[Dict[str, Any]]:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('SELECT * FROM users ORDER BY created_at DESC LIMIT ?', (limit,))
            return [dict(row) for row in cursor.fetchall()]

    def get_recent_payments(self, limit: int = 20) -> List[Dict[str, Any]]:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute('''
                SELECT p.*, u.username, u.full_name FROM payments p
                LEFT JOIN users u ON u.user_id = p.user_id
                ORDER BY p.id DESC LIMIT ?
            ''', (limit,))
            return [dict(row) for row in cursor.fetchall()]

