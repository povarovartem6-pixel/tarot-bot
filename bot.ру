@router.message(Command("gift"))
async def gift_prediction(message: Message):
    parts = message.text.split()
    if len(parts) < 2:
        await message.answer("❌ Укажи ID: <code>/gift USER_ID</code>")
        return

    try:
        friend_id = int(parts[1])
    except ValueError:
        await message.answer("❌ Неверный формат ID")
        return

    user_id = message.from_user.id
    if friend_id == user_id:
        await message.answer("❌ Нельзя подарить самому себе!")
        return

    user = db.get_user(user_id)
    is_owner = db.is_owner(user_id)

    if not is_owner and user["balance"] < PREDICTION_PRICE:
        await message.answer(
            f"❌ Недостаточно звёзд! Нужно {PREDICTION_PRICE}⭐, у тебя {user['balance']}⭐",
            reply_markup=top_up_keyboard()
        )
        return

    friend = db.get_user(friend_id)
    if not friend:
        friend = db.create_user(friend_id, f"friend_{friend_id}", "Друг")

    if not is_owner:
        db.spend_stars(user_id, PREDICTION_PRICE)
        db.add_history(user_id, "gift_sent", PREDICTION_PRICE, f"Подарок {friend_id}")

    db.add_stars(friend_id, PREDICTION_PRICE)
    db.add_history(friend_id, "gift_received", PREDICTION_PRICE, f"Подарок от {user_id}")

    try:
        await bot.send_message(
            friend_id,
            f"🎁 <b>Тебе подарили прогноз!</b>\n\n"
            f"⭐ +{PREDICTION_PRICE}⭐ зачислено на баланс\n"
            f"💰 Текущий баланс: <b>{db.get_user(friend_id)['balance']}⭐</b>\n\n"
            "Скорее получи свой прогноз! 🔮"
        )
    except Exception:
        pass

    user_after = db.get_user(user_id)
    if is_owner:
        await message.answer(
            f"✅ <b>Подарок отправлен!</b>\n\n"
            f"👑 <i>Режим владельца — без списания</i>\n"
            f"🎁 Друг получил {PREDICTION_PRICE}⭐",
            reply_markup=main_keyboard(True)
        )
    else:
        await message.answer(
            f"✅ <b>Подарок отправлен!</b>\n\n"
            f"⭐ Списано: {PREDICTION_PRICE}⭐\n"
            f"💰 Остаток: {user_after['balance']}⭐",
