@router.callback_query(F.data.startswith("pred_"))
async def handle_prediction(callback: CallbackQuery, state: FSMContext):
    prediction_type = callback.data.replace("pred_", "")
    user_id = callback.from_user.id

    db.check_daily_reset(user_id)
    user = db.get_user(user_id)
    is_owner = db.is_owner(user_id)

    if prediction_type == "dream":
        if not is_owner and user["free_today"] == 0 and user["balance"] < PREDICTION_PRICE:
            await callback.answer("Недостаточно звёзд!", show_alert=True)
            await callback.message.edit_text(
                f"❌ <b>Недостаточно звёзд!</b>\n"
                f"Нужно {PREDICTION_PRICE}⭐, у тебя {user['balance']}⭐\n\n"
                "Пополни баланс:",
                reply_markup=top_up_keyboard()
            )
            return
        await state.set_state(PredictionStates.waiting_for_dream)
        await callback.message.edit_text(
            "🌙 <b>Расскажи свой сон</b>\n\n"
            "Опиши его подробно — я найду символы и расшифрую послание.\n\n"
            "<i>Например: «Мне снилось море, я плыл на корабле...»</i>"
        )
        await callback.answer()
        return

    if is_owner:
        await process_prediction(callback, prediction_type, user_id, free=True, owner=True)
        return

    if user["free_today"] > 0:
        if db.use_free_prediction(user_id):
            await process_prediction(callback, prediction_type, user_id, free=True)
            return

    if user["balance"] >= PREDICTION_PRICE:
        await process_prediction(callback, prediction_type, user_id, free=False)
    else:
        await callback.answer("Недостаточно звёзд!", show_alert=True)
        await callback.message.edit_text(
            f"❌ <b>Недостаточно звёзд для прогноза!</b>\n"
            f"Нужно {PREDICTION_PRICE}⭐, а у тебя {user['balance']}⭐\n\n"
            "Пополни баланс:",
            reply_markup=top_up_keyboard()
        )

async def process_prediction(callback: CallbackQuery, prediction_type: str, user_id: int,
                              free: bool, owner: bool = False):
    gen = PredictionGenerator()

    if prediction_type == "tarot_day":
        result = gen.tarot_day()
        preview = "Карта дня"
    elif prediction_type == "yes_no":
        result = gen.yes_no()
        preview = "Ответ Да/Нет"
    elif prediction_type == "daily_advice":
        result = gen.daily_advice()
        preview = "Совет дня"
    elif prediction_type == "relationship":
        result = gen.relationship()
        preview = "Расклад на отношения"
    elif prediction_type == "weekly":
        result = gen.weekly()
        preview = "Прогноз на неделю"
    elif prediction_type == "yearly":
        result = gen.yearly()
        preview = "Прогноз на год"
    else:
        result = "Неизвестный тип прогноза"
        preview = "Неизвестно"

    db.increment_predictions(user_id)

    if owner:
        db.add_history(user_id, f"owner_{prediction_type}", 0, preview)
        text = f"🔮 {result}\n\n👑 <i>Режим владельца — бесплатно</i>"
    elif free:
        db.add_history(user_id, f"free_{prediction_type}", 0, preview)
        user = db.get_user(user_id)
        text = f"🔮 {result}\n\n"
        text += f"✅ <b>Бесплатный прогноз использован</b>\n"
        text += f"Осталось бесплатных: <b>{user['free_today']}</b>\n"
        text += f"💰 Баланс: <b>{user['balance']}⭐</b>"
    else:
        db.spend_stars(user_id, PREDICTION_PRICE)
        db.add_history(user_id, prediction_type, PREDICTION_PRICE, preview)
