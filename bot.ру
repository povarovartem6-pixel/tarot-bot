@router.message(PredictionStates.waiting_for_custom_amount)
async def process_custom_amount(message: Message, state: FSMContext):
    try:
        amount = int((message.text or "").strip())
    except ValueError:
        await message.answer("❌ Введи корректное число!")
        return

    if amount < MIN_TOP_UP:
        await message.answer(f"❌ Минимальная сумма: {MIN_TOP_UP}⭐")
        return
    if amount % TOP_UP_STEP != 0:
