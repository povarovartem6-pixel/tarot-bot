    full_name = message.from_user.full_name

    user = db.get_user(user_id)
    if not user:
        user = db.create_user(user_id, username, full_name)
        if user_id != OWNER_ID:
            try:
                await bot.send_message(
                    OWNER_ID,
                    f"🆕 <b>Новый пользователь!</b>\n\n"
                    f"👤 Имя: {full_name}\n"
                    f"🔗 Username: @{username or 'нет'}\n"
                    f"🆔 ID: <code>{user_id}</code>"
                )
            except Exception:
                pass

    db.update_user_visit(user_id)
    db.check_daily_reset(user_id)
    user = db.get_user(user_id)

    is_owner = db.is_owner(user_id)
    balance = user["balance"]
    free_today = user["free_today"]
    predictions_available = balance // PREDICTION_PRICE

    text = f"🌟 <b>Привет, {message.from_user.first_name}!</b> 👋\n\n"
    text += "Я — твой проводник в мир тайн и предсказаний 🔮\n"
    text += "Открой завесу будущего и узнай, что готовит тебе судьба.\n\n"

    if is_owner:
        text += "👑 <b>Режим владельца</b> — все прогнозы бесплатны навсегда!\n\n"
    else:
        text += f"🔮 <b>Бесплатных прогнозов сегодня:</b> {free_today}/{FREE_PREDICTIONS_DAILY}\n"
        text += f"💰 <b>Твой баланс:</b> {balance}⭐\n"
        text += f"📊 Хватит ещё на <b>{predictions_available}</b> прогнозов\n\n"
        if balance < 30:
            text += "⚠️ <i>У тебя осталось мало звёзд — пора пополнить!</i>\n\n"

    text += "✨ Что хочешь узнать?"

    await message.answer(text, reply_markup=main_keyboard(is_owner))

